# gates_of_heck configuration. All keys optional; delete what you don't use.
GOH_MAX_LINES=500                 # file-length cap; unset disables the check
# GOH_EXCLUDE='vendor/|\.generated\.'   # shared vendor/generated exemption
# GOH_ALLOW='<glyph>'                          # extra permitted characters (keep minimal)
# GOH_LINE_EXCLUDE=''                  # nothing vendored/generated: LiquidContainer is first-party (in-repo SPM package, no upstream)
# GOH_PY_COV_MIN=95
# Swift coverage (G1), measured 2026-10-15: Koffee.app is 40.63% (3205/7889
# lines). The global floor is that number, and PER-TARGET floors aim it at the
# app -- AppAuth, GRDB, KeychainAccess and LiquidContainer are third-party and
# report 0%, which would otherwise drag a whole-tree total to ~14% and make the
# gate a statement about dependencies rather than about Koffee.
GOH_SWIFT_COV_MIN=40
GOH_SWIFT_COV_FLOORS="$PWD/tools/coverage_floors.jsonc"
GOH_SWIFT_MODE=xcode              # Koffee app + test bundle via xcodebuild
GOH_SWIFT_SCHEME=KoffeeTests
GOH_SWIFT_PROJECT=Koffee.xcodeproj
# GOH_MAX_SCRATCH_GB=25           # disk-hygiene ceiling (full runs only)

# Every scanner's floor (goh v0.27.0, docs/config.md): a full-scope scan that
# reads less than this has lost its subject and is red, not clean. Nine tenths
# of what each read on 2026-10-14 (the house rule); lower one with the tree in
# the same commit, never to absorb a scan that went blind.
GOH_EMOJI_MIN_FILES=126             # read 140
GOH_CONFLICT_MARKERS_MIN_FILES=126  # read 141
GOH_FILE_LENGTH_MIN_FILES=99        # read 111
GOH_SECRETS_MIN_FILES=126           # read 140
GOH_SHELL_LINT_MIN_FILES=7          # read 8
GOH_EARLY_EXIT_PIPE_MIN_FILES=11    # read 13
GOH_DEAD_AFTER_EXEC_MIN_FILES=11    # read 13
GOH_BARE_HOOK_INDEX_MIN_FILES=11    # read 13
GOH_BARE_PYTHON_MIN_FILES=5         # read 6
GOH_UNREAPED_SPAWN_MIN_FILES=1      # read 2
